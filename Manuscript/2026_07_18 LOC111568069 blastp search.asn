Blast4-request ::= {
  body queue-search {
    program "blastp",
    service "plain",
    queries seq-loc-list {
      whole other {
        accession "XP_023125306",
        version 1
      }
    },
    subject database "nr",
    algorithm-options {
      {
        name "EvalueThreshold",
        value cutoff e-value { 5, 10, -2 }
      },
      {
        name "WordSize",
        value integer 5
      },
      {
        name "WordThreshold",
        value integer 20
      },
      {
        name "UngappedMode",
        value boolean FALSE
      },
      {
        name "PercentIdentity",
        value real { 0, 10, 0 }
      },
      {
        name "HitlistSize",
        value integer 100
      },
      {
        name "EffectiveSearchSpace",
        value big-integer 0
      },
      {
        name "DbLength",
        value big-integer 0
      },
      {
        name "WindowSize",
        value integer 40
      },
      {
        name "SegFiltering",
        value boolean FALSE
      },
      {
        name "MaskAtHash",
        value boolean FALSE
      },
      {
        name "MatrixName",
        value string "BLOSUM62"
      },
      {
        name "GapOpeningCost",
        value integer 11
      },
      {
        name "GapExtensionCost",
        value integer 1
      },
      {
        name "CompositionBasedStats",
        value integer 2
      },
      {
        name "SmithWatermanMode",
        value boolean FALSE
      }
    },
    program-options {
      {
        name "EntrezQuery",
        value string "txid7955 [ORGN] OR txid8090 [ORGN] OR txid69293 [ORGN]
 OR txid9606 [ORGN]"
      }
    },
    format-options {
      {
        name "Web_JobTitle",
        value string "XP_023125306:progesterone receptor-like isoform..."
      },
      {
        name "Web_OrganismName",
        value string "Danio rerio (taxid:7955)"
      },
      {
        name "Web_OrganismName",
        value string "Japanese rice fish (taxid:8090)"
      },
      {
        name "Web_OrganismName",
        value string "three-spined stickleback (taxid:69293)"
      },
      {
        name "Web_OrganismName",
        value string "Homo sapiens (PARIS) (taxid:9606)"
      },
      {
        name "Web_ShortQueryAdjust",
        value boolean TRUE
      }
    }
  }
}

